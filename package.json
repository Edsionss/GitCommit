{
  "name": "cognitoocean",
  "project": "CognitoOcean",
  "version": "0.0.8",
  "description": "Charting Your Path to Clarity.By Electron with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "Bocean.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "set NODE_OPTIONS=--enable-source-maps --no-warnings && set CHCP=65001 && electron-vite dev",
    "exe:win": "vite build & electron-builder --win",
    "build": "npm run typecheck && electron-vite build",
    "tbuild": "electron-vite build",
    "package": "npm run tbuild && electron-builder",
    "package:win": "npm run tbuild && electron-builder --win",
    "package:mac": "npm run tbuild && electron-builder --mac",
    "package:linux": "npm run tbuild && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "make-lite": "ts-node scripts/MakeLite.ts",
    "make-lite:dry-run": "ts-node scripts/MakeLite.ts --dry-run"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "^1.15.0",
    "@imengyu/vue3-context-menu": "^1.5.2",
    "ant-design-vue": "^4.2.3",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.2.0",
    "chart.js": "^4.4.3",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-chart-financial": "^0.2.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.10",
    "electron-conf": "^1.3.0",
    "electron-updater": "^6.3.9",
    "lodash": "^4.17.21",
    "marked": "^15.0.8",
    "nanoid": "^5.1.5",
    "openai": "^5.13.1",
    "pinia": "^2.2.0",
    "puppeteer-core": "^24.20.0",
    "simple-git": "^3.22.0",
    "technicalindicators": "^3.1.0",
    "vue-chartjs": "^5.3.1",
    "vue-router": "^4.5.0",
    "ws": "^8.18.3",
    "yahoo-finance2": "^2.13.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@iconify/vue": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^35.0.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "sass": "^1.90.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.electron.app",
    "productName": "CognitoOcean",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/CognitoOcean.ico"
    },
    "mac": {
      "icon": "build/CognitoOcean.icns"
    },
    "linux": {
      "icon": "build/CognitoOcean.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
