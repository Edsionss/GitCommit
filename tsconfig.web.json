{
  // 保留原继承
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",

  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],

  "compilerOptions": {
    // ----------------------------------------------------------
    // ✅ 现代化配置（TypeScript 6+ 推荐写法）
    // ----------------------------------------------------------
    "module": "ESNext",
    "moduleResolution": "bundler", // 替代 Node 解析，更贴合 Vite、Electron 等现代打包方案
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // ----------------------------------------------------------
    // ✅ 质量与安全性
    // ----------------------------------------------------------
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true,

    // ----------------------------------------------------------
    // 🚫 已弃用项迁移
    // ----------------------------------------------------------
    // ❌ 移除 baseUrl（已弃用）
    // ✅ 改用新版 import alias 写法（无需 baseUrl）
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@/*": ["./src/renderer/src/*"],
      "@components/*": ["./src/renderer/src/components/*"],
      "@views/*": ["./src/renderer/src/views/*"],
      "@api/*": ["./src/renderer/src/api/*"],
      "@assets/*": ["./src/renderer/src/assets/*"],
      "@composables/*": ["./src/renderer/src/composables/*"],
      "@router/*": ["./src/renderer/src/router/*"],
      "@shared/*": ["./src/shared/*"],
      "@sharedType/*": ["./src/shared/types/dtos/*"],
      "@type/*": ["./src/renderer/src/types/*"],
      "@utils/*": ["./src/renderer/src/utils/*"]
    },

    // ----------------------------------------------------------
    // ⚙️ 兼容性与类型支持
    // ----------------------------------------------------------
    // "types": ["electron-vite/client"],
    "types": ["vite/client"],

    // ----------------------------------------------------------
    // 🧩 忽略即将弃用的特性（防止警告）
    // ----------------------------------------------------------
    "ignoreDeprecations": "6.0"
  }
}
